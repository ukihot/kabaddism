// ネガティブイベント（concept §15 の15種 / FR-NEG-01）
//
// stage 0 = 予兆, 1 = 本番, 2 = 深刻（FR-SIM-07）。
// stage > 0 のイベントは対応策を2つ以上持つ（FR-NEG-02: 唯一解を作らない）。
// trigger は必ず対象そのものの状態を見る。全国平均は使わない（FR-SIM-05）。
[
    // ── 生活余力不足 ──
    (
        id: "life_strain",
        scope: Person,
        stage: 0,
        trigger: [ LifeSlackBelow(0.38) ],
        base_chance: 0.05,
        cooldown_days: 45,
        outcomes: [],
        news_key: "event.life_strain",
        kind: Person,
        weight: 3,
        remedies: [],
    ),
    (
        id: "overtime_absence",
        scope: Cohort,
        stage: 1,
        trigger: [ LifeSlackBelow(0.30) ],
        base_chance: 0.030,
        cooldown_days: 40,
        outcomes: [ MissPractice(ratio: 0.6) ],
        news_key: "event.overtime_absence",
        kind: Economy,
        weight: 4,
        remedies: ["kabaddi_leave", "rent_subsidy", "athlete_support"],
    ),
    (
        id: "sport_pause",
        scope: Person,
        stage: 2,
        prerequisite: Some("life_strain"),
        trigger: [ LifeSlackBelow(0.28) ],
        base_chance: 0.020,
        cooldown_days: 90,
        outcomes: [ Pause(grace_days: 0) ],
        news_key: "event.sport_pause",
        kind: Person,
        weight: 6,
        remedies: ["athlete_support", "rent_subsidy", "community_grant"],
    ),

    // ── 疲労蓄積 ──
    (
        id: "fatigue_warning",
        scope: Person,
        stage: 0,
        trigger: [ FatigueAbove(0.62) ],
        base_chance: 0.07,
        cooldown_days: 30,
        outcomes: [],
        news_key: "event.fatigue_warning",
        kind: Person,
        weight: 3,
        remedies: [],
    ),
    (
        id: "camp_condition",
        scope: Person,
        stage: 1,
        prerequisite: Some("fatigue_warning"),
        trigger: [ FatigueAbove(0.70) ],
        base_chance: 0.040,
        cooldown_days: 30,
        outcomes: [ MissPractice(ratio: 0.5) ],
        news_key: "event.camp_condition",
        kind: Person,
        weight: 4,
        remedies: ["dorm_repair", "medical_agreement", "canteen"],
    ),
    (
        id: "practice_injury",
        scope: Person,
        stage: 2,
        prerequisite: Some("fatigue_warning"),
        trigger: [ FatigueAbove(0.80), NotInjured ],
        base_chance: 0.030,
        cooldown_days: 60,
        outcomes: [ Injure(severity: 0.8) ],
        news_key: "event.practice_injury",
        kind: Person,
        weight: 7,
        remedies: ["medical_agreement", "dorm_repair", "canteen"],
    ),

    // ── 医療不足 ──
    (
        id: "treatment_wait",
        scope: District,
        stage: 1,
        trigger: [ MedicalAccessBelow(0.33) ],
        base_chance: 0.025,
        cooldown_days: 60,
        outcomes: [ Effect(Infra(field: Medical, delta: -0.02)) ],
        news_key: "event.treatment_wait",
        kind: Economy,
        weight: 5,
        remedies: ["medical_agreement", "dorm_repair"],
    ),

    // ── 食環境悪化 ──
    (
        id: "canteen_notice",
        scope: Facility,
        stage: 0,
        trigger: [ FacilityKindIs(Canteen), StaffingBelow(0.85) ],
        base_chance: 0.04,
        cooldown_days: 40,
        outcomes: [],
        news_key: "event.canteen_notice",
        kind: Local,
        weight: 3,
        remedies: [],
    ),
    (
        id: "canteen_closed",
        scope: Facility,
        stage: 1,
        prerequisite: Some("canteen_notice"),
        trigger: [ FacilityKindIs(Canteen), StaffingBelow(0.7) ],
        base_chance: 0.03,
        cooldown_days: 90,
        outcomes: [ SuspendFacility ],
        news_key: "event.canteen_closed",
        kind: Local,
        weight: 5,
        remedies: ["canteen", "community_grant"],
    ),
    (
        id: "food_decline",
        scope: District,
        stage: 1,
        trigger: [ FoodAccessBelow(0.35) ],
        base_chance: 0.02,
        cooldown_days: 60,
        outcomes: [ Effect(Infra(field: Food, delta: -0.01)) ],
        news_key: "event.food_decline",
        kind: Economy,
        weight: 4,
        remedies: ["canteen", "rent_subsidy"],
    ),

    // ── 住環境悪化 ──
    (
        id: "dorm_breakdown",
        scope: Facility,
        stage: 1,
        trigger: [ FacilityKindIs(Dormitory), QualityBelow(0.62) ],
        base_chance: 0.030,
        cooldown_days: 60,
        outcomes: [ DamageFacility(quality: 0.12) ],
        news_key: "event.dorm_breakdown",
        kind: Local,
        weight: 5,
        remedies: ["dorm_repair", "vacant_housing"],
    ),

    // ── 指導能力不足 ──
    (
        id: "intake_suspended",
        scope: Facility,
        stage: 1,
        trigger: [ FacilityKindIs(Dojo), OverEnrolled(1.0) ],
        base_chance: 0.035,
        cooldown_days: 50,
        outcomes: [ SuspendFacility ],
        news_key: "event.intake_suspended",
        kind: Local,
        weight: 6,
        remedies: ["public_dojo", "coach_dispatch", "school_night"],
    ),
    (
        id: "coach_leave",
        scope: Facility,
        stage: 1,
        trigger: [ FacilityKindIs(Dojo), StaffingBelow(0.62) ],
        base_chance: 0.020,
        cooldown_days: 90,
        outcomes: [ StaffLeave(role: Coach, amount: 1.0, days: 60) ],
        news_key: "event.coach_leave",
        kind: Local,
        weight: 5,
        remedies: ["coach_dispatch", "coach_training"],
    ),

    // ── 参加機会不足 ──
    (
        id: "missed_selection",
        scope: District,
        stage: 1,
        trigger: [ ScoutingBelow(0.28) ],
        base_chance: 0.020,
        cooldown_days: 80,
        outcomes: [ MissSelection ],
        news_key: "event.missed_selection",
        kind: Local,
        weight: 4,
        remedies: ["regional_scouting", "school_night"],
    ),
    (
        id: "emigration_wish",
        scope: Person,
        stage: 1,
        trigger: [ AbilityAbove(55.0), LifeSlackBelow(0.33) ],
        base_chance: 0.012,
        cooldown_days: 120,
        outcomes: [ Emigrate ],
        news_key: "event.emigration_wish",
        kind: Person,
        weight: 8,
        remedies: ["athlete_support", "community_grant", "rent_subsidy"],
    ),

    // ── 財政・制度 ──
    (
        id: "construction_halt",
        scope: District,
        stage: 1,
        trigger: [ ProjectStalled ],
        base_chance: 0.060,
        cooldown_days: 30,
        outcomes: [ StallProject ],
        news_key: "event.construction_halt",
        kind: Project,
        weight: 5,
        remedies: ["private_dojo", "sponsor_meeting"],
    ),
    (
        id: "investment_hold",
        scope: District,
        stage: 1,
        trigger: [ TrustBelow(0.45) ],
        base_chance: 0.020,
        cooldown_days: 60,
        outcomes: [ HoldInvestment(trust: 0.02) ],
        news_key: "event.investment_hold",
        kind: Economy,
        weight: 5,
        remedies: ["sponsor_meeting", "guild_audit"],
    ),

    // ── 決済 ──
    (
        id: "credit_shrink",
        scope: Nation,
        stage: 1,
        trigger: [ GuildCoverageBelow(0.9) ],
        base_chance: 0.040,
        cooldown_days: 40,
        outcomes: [ ShrinkCredit(ratio: 0.94) ],
        news_key: "event.credit_shrink",
        kind: Economy,
        weight: 7,
        remedies: ["community_grant", "guild_audit"],
    ),
    (
        id: "venue_congestion",
        scope: District,
        stage: 1,
        trigger: [ PaymentVenueBelow(0.33) ],
        base_chance: 0.035,
        cooldown_days: 40,
        outcomes: [ CongestPayment(minutes: 25.0) ],
        news_key: "event.venue_congestion",
        kind: Economy,
        weight: 4,
        remedies: ["payment_venue", "community_grant"],
    ),
    (
        id: "shop_shrink",
        scope: Business,
        stage: 1,
        trigger: [ BusinessBalanceBelow(-40.0) ],
        base_chance: 0.030,
        cooldown_days: 60,
        outcomes: [ ShrinkBusiness(ratio: 0.85) ],
        news_key: "event.shop_shrink",
        kind: Economy,
        weight: 5,
        remedies: ["sponsor_meeting", "private_dojo"],
    ),
]
